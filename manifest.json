{
  "manifest_version": 3,
  "name": "Browser Preference Switcher",
  "version": "0.1.1",
  "description": "Change browser request headers on selected sites while keeping the real browser engine.",
  "homepage_url": "https://github.com/KyleStay/browser-preference-switcher",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "https://*.icloud.com/*",
    "https://icloud.com/*",
    "https://*.google.com/*",
    "https://google.com/*",
    "https://*.youtube.com/*",
    "https://youtube.com/*",
    "https://*.youtu.be/*",
    "https://youtu.be/*",
    "https://*.microsoft.com/*",
    "https://microsoft.com/*",
    "https://*.cloud.microsoft/*",
    "https://cloud.microsoft/*",
    "https://*.microsoft365.com/*",
    "https://microsoft365.com/*",
    "https://*.office.com/*",
    "https://office.com/*",
    "https://*.office365.com/*",
    "https://office365.com/*",
    "https://*.outlook.com/*",
    "https://outlook.com/*",
    "https://*.live.com/*",
    "https://live.com/*",
    "https://*.onedrive.com/*",
    "https://onedrive.com/*",
    "https://*.sharepoint.com/*",
    "https://sharepoint.com/*",
    "https://*.bing.com/*",
    "https://bing.com/*",
    "https://*.msn.com/*",
    "https://msn.com/*",
    "https://*.azure.com/*",
    "https://azure.com/*",
    "https://*.xbox.com/*",
    "https://xbox.com/*",
    "https://*.windows.com/*",
    "https://windows.com/*",
    "https://*.microsoftonline.com/*",
    "https://microsoftonline.com/*",
    "https://*.apple.com/*",
    "https://apple.com/*",
    "https://versionhistory.googleapis.com/*",
    "https://edgeupdates.microsoft.com/*",
    "https://developer.apple.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html",
    "default_title": "Browser Preference Switcher"
  }
}
